# ═══════════════════════════════════════════════════════════════
# NHY-QR Ad Manager — Azure deployment configuration
#
# Copy to .env.azure and fill in the blanks for a manual deploy with
# deploy/azure/deploy-azure.sh. .env.azure is git-ignored — never commit it.
#
# In CI these same values come from GitHub Actions secrets instead; see
# AZURE_DEPLOYMENT.md. No credential belongs in this repository.
# ═══════════════════════════════════════════════════════════════

# ─── Azure coordinates (not secret) ────────────────────────────
# These match the existing Nautical deployment so this app lands on the
# already-paid-for App Service plan rather than provisioning a second one.
AZURE_SUBSCRIPTION_ID=73888504-282d-4ee8-acdb-0679df3b51e3
AZURE_TENANT_ID=2472daa8-c3ca-4f6c-a482-c331f629cbeb
AZURE_RESOURCE_GROUP=posnauticals-rg
AZURE_APP_SERVICE_PLAN=posnauticals-plan
AZURE_LOCATION=southindia
AZURE_APP_NAME=nhy-ad-manager

# ─── Application runtime settings ──────────────────────────────
NODE_ENV=production
# Leave FRONTEND_URL blank to default to the App Service hostname.
FRONTEND_URL=

# ─── Secrets — leave blank here, supply at deploy time ─────────
# PostgreSQL. Point at a database dedicated to this app; do not share the
# POS schema. Azure Database for PostgreSQL requires sslmode=require.
DATABASE_URL=

# openssl rand -base64 64
JWT_SECRET=
JWT_REFRESH_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
FAST2SMS_API_KEY=

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
