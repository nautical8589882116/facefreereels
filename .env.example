# ═══════════════════════════════════════════════════════════════
# NHY-QR Ad Manager — Production Environment Variables
# Copy this file to .env and fill in all values
# ═══════════════════════════════════════════════════════════════

# ─── Server Configuration ─────────────────────────────────────
NODE_ENV=production
PORT=4000
BACKEND_URL=https://api.yourdomain.com
FRONTEND_URL=https://yourdomain.com

# ─── Database ─────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://username:password@localhost:5432/nhyqr_ad_manager?schema=public

# ─── JWT Secrets ──────────────────────────────────────────────
# Generate strong random strings: openssl rand -base64 64
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── OTP / SMS Configuration ──────────────────────────────────
# Option 1: Twilio (Global)
TWILIO_SID=AC_your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Option 2: Fast2SMS (India only)
FAST2SMS_API_KEY=your_fast2sms_api_key

# ─── Razorpay Payments ────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ─── Cloudinary (File Storage) ────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── OAuth: Instagram / Facebook ──────────────────────────────
# Get from: https://developers.facebook.com/apps
INSTAGRAM_CLIENT_ID=your_facebook_app_id
INSTAGRAM_CLIENT_SECRET=your_facebook_app_secret
INSTAGRAM_CALLBACK_URL=/api/oauth/instagram/callback

FACEBOOK_CLIENT_ID=your_facebook_app_id
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=/api/oauth/facebook/callback

# ─── OAuth: YouTube (Google) ──────────────────────────────────
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
YOUTUBE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_google_client_secret
YOUTUBE_CALLBACK_URL=/api/oauth/youtube/callback

# ─── Anthropic (AI Caption Generation) ────────────────────────
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-api-key

# ─── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# ─── File Upload ──────────────────────────────────────────────
MAX_FILE_SIZE=52428800

# ═══════════════════════════════════════════════════════════════
# Frontend Environment Variables (create webapp/.env.local)
# ═══════════════════════════════════════════════════════════════
# VITE_API_URL=https://api.yourdomain.com/api
# VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
# VITE_APP_NAME=NHY-QR Ad Manager
