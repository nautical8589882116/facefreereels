# ═══════════════════════════════════════════════════════════════
# NHY-QR Ad Manager — Production Environment Variables
# Copy this file to .env and fill in all values
# ═══════════════════════════════════════════════════════════════

# ─── Server Configuration ─────────────────────────────────────
# Local dev defaults shown; switch to production URLs when deploying.
NODE_ENV=development
PORT=4000
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# ─── Database ─────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://username:password@localhost:5432/nhyqr_ad_manager?schema=public

# ─── JWT Secrets ──────────────────────────────────────────────
# Generate strong random strings: openssl rand -base64 64
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── OTP / SMS Configuration ──────────────────────────────────
# Option 1: Twilio (Global) — code reads these exact names
TWILIO_SID=AC_your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_VERIFY_SERVICE_SID=VA_your_twilio_verify_service_sid

# Option 2: Fast2SMS (India only)
FAST2SMS_API_KEY=your_fast2sms_api_key

# ─── Razorpay Payments ────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ─── Supabase Storage (File Storage) ──────────────────────────
# Project URL: https://<project-ref>.supabase.co
# Service-role key: Supabase dashboard → Project Settings → API
# (server-side only — never expose to the browser)
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=assets

# ─── OAuth: Instagram / Facebook ──────────────────────────────
# Get from: https://developers.facebook.com/apps
INSTAGRAM_CLIENT_ID=your_facebook_app_id
INSTAGRAM_CLIENT_SECRET=your_facebook_app_secret
INSTAGRAM_CALLBACK_URL=/api/oauth/instagram/callback

FACEBOOK_CLIENT_ID=your_facebook_app_id
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=/api/oauth/facebook/callback

# ─── OAuth: YouTube (Google) ──────────────────────────────────
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
YOUTUBE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_google_client_secret
YOUTUBE_CALLBACK_URL=/api/oauth/youtube/callback

# ─── Anthropic (AI Caption Generation) ────────────────────────
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-api-key

# ─── Dev / Test OTP Bypass ──────────────────────────────────
# Set DEV_OTP_BYPASS=true to skip SMS sending and allow a fixed code.
# DEV_OTP_CODE is the code the frontend can use in place of the real OTP.
# NEVER enable this in production.
DEV_OTP_BYPASS=false
DEV_OTP_CODE=000000
# ─── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# ─── Logging ──────────────────────────────────────────────────
# Levels: debug, info, warn, error, silent
LOG_LEVEL=info
LOG_REQUEST_BODY=false
LOG_RESPONSE_BODY=false
LOG_SERVICE_ARGS=false
LOG_SERVICE_RESULT=false
LOG_STACK=true
MAX_LOG_VALUE_LENGTH=2000

# ─── File Upload ──────────────────────────────────────────────
MAX_FILE_SIZE=52428800

# ─── Reel Generation: AI Visuals & Voiceover (xAI Grok) ───────
# A single xAI key powers both the scene images and the voiceover.
# Get a key: https://console.x.ai  →  API Keys
# If unset: visuals fall back to an animated gradient, audio is silent.
XAI_API_KEY=
# Optional model overrides (only set if xAI renames them).
XAI_IMAGE_MODEL=grok-2-image-1212
XAI_TTS_MODEL=grok-voice-latest
# Default Grok voice when a reel has none. Built-in: ara, eve, leo, rex, sal.
XAI_TTS_VOICE=eve

# ffmpeg / ffprobe binaries (defaults to PATH lookup). Set absolute paths if
# they are not on PATH. Required for reel rendering.
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# Set to "true" to enable a subtle Ken Burns zoom on slideshow images.
REEL_KENBURNS=false

# Scheduled publishing worker
# Local/Docker cron. Vercel serverless should call /api/jobs/scheduler/publish-due
# from a hosted cron instead of relying on an in-process worker.
SCHEDULER_AUTOPUBLISH_ENABLED=false
SCHEDULER_AUTOPUBLISH_DRY_RUN=false
SCHEDULER_AUTOPUBLISH_CRON=* * * * *
SCHEDULER_AUTOPUBLISH_LIMIT=10
SCHEDULER_AUTOPUBLISH_RUN_ON_START=false
# Optional ISO datetime. If set, the worker only auto-publishes posts scheduled
# at or after this time. Useful when enabling cron without publishing old backlog.
SCHEDULER_AUTOPUBLISH_NOT_BEFORE=
SCHEDULER_JOB_SECRET=change_this_to_a_long_random_secret

# ═══════════════════════════════════════════════════════════════
# Frontend Environment Variables (create webapp/.env.local)
# ═══════════════════════════════════════════════════════════════
# VITE_API_URL=http://localhost:4000/api
# VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
# VITE_APP_NAME=NHY-QR Ad Manager
